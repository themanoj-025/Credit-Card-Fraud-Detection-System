!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.local.*
.vscode/mcp.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.ipynb_checkpoints/

# ─── OS Artifacts ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
nul
