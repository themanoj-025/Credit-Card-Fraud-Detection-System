models/*.pkl
models/*.joblib
models/rag_index/
!models/.gitkeep
models/threshold.txt
models/*.json
models/*.sha256
catboost_info/

# ML model binary formats
*.pth
*.h5
*.pt
*.ckpt
*.onnx

# ─── MLflow & Databases ───────────────────────────────────────
mlruns/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sql.gz
*.rdb
test_*.db

