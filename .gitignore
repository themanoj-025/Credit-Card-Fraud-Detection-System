logs/
*.log
*.dump
*.stackdump
monitoring/*.json
monitoring/drift_reports/

# ─── Reports & Outputs ────────────────────────────────────────
reports/
reports/figures/
reports/*.csv
reports/*.json
reports/*.html
reports/*.pdf

