# ─── Secrets & Environment (CRITICAL) ───────────────────────────
.env
.env.*
*.env
.env.local
.env.development
.env.test
.env.staging
.env.production
!.env.example
!.env.template
!.env.sample

# Private keys, certificates & credentials
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
*.der
*.id_rsa
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud & service credentials
credentials.json
*credentials*.json
client_secret*.json
client_secrets*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
google-services.json
google-credentials*.json
GoogleService-Info.plist
.aws/
.azure/
.gcp/
gcloud/
.act-secrets
*.secrets.*
.secrets
*.publishsettings
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
kubeconfig
*.kubeconfig
.kube/

# Password vaults & cryptographic stores
*.kdbx

# Authentication tokens & configs
.netrc
.pypirc
.npmrc
*token*.json
token.pickle
auth*.json

# ─── Python Runtime & Builds ──────────────────────────────────
*.py[cod]
*$py.class
__pycache__/
*.so
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ─── Virtual Environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/
.venv*/
env.bak/
venv.bak/

# ─── Data & Datasets ──────────────────────────────────────────
data/raw/*
!data/raw/.gitkeep
!data/raw/*.dvc
data/processed/
data/interim/*
data/external/*
!data/interim/.gitkeep
!data/external/.gitkeep
data/*.csv
data/*.pkl
data/*.parquet
Dataset/
*.parquet

